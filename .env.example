# Copy this file to .env for local development. NEVER commit .env.
# In production (Render), set these in the service's "Environment" tab instead.

# ---------------------------------------------------------------------------
# Database (PostgreSQL). Render/Railway give you this URL automatically.
# Local dev: leave empty and run `python scripts/local_db.py` to start an
# embedded Postgres; it prints the URL to paste here.
DATABASE_URL=

# ---------------------------------------------------------------------------
# App security
# Long random string. Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# Used to encrypt the stored Jobber tokens. If you change it, reconnect Jobber.
APP_SECRET_KEY=
# Public address of the app (used as the Jobber OAuth callback).
APP_BASE_URL=http://localhost:8501

# First admin account, created automatically on first start if no users exist.
# Remove BOOTSTRAP_ADMIN_PASSWORD after the first login.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Admin

# ---------------------------------------------------------------------------
# Jobber (READ ONLY) — from developer.getjobber.com > your app
JOBBER_CLIENT_ID=
JOBBER_CLIENT_SECRET=
# Optional: only used to seed the DB once. Normally you connect via the app's
# "Connections" page (admin) and this stays empty.
JOBBER_REFRESH_TOKEN=
JOBBER_API_VERSION=2026-05-12
JOBBER_PAGE_SIZE=50
JOBBER_HISTORY_START=2026-09-01
SCHEDULE_LOOKBACK_DAYS=45
SCHEDULE_LOOKAHEAD_DAYS=60

# ---------------------------------------------------------------------------
# Pipedrive (READ ONLY) — Pipedrive > profile picture > Personal preferences > API
PIPEDRIVE_API_TOKEN=
# The part before .pipedrive.com in your Pipedrive URL
PIPEDRIVE_COMPANY_DOMAIN=
PIPEDRIVE_SALES_PIPELINE_ID=1

# ---------------------------------------------------------------------------
# Optional: AI quote classification (rules-based classifier works without it)
OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# Sync
SYNC_INTERVAL_MINUTES=15
SYNC_OVERLAP_MINUTES=10
STALE_AFTER_MINUTES=60
INFERENCE_WINDOW_DAYS=14
ESTIMATE_INFERENCE_WINDOW_DAYS=30
# Quote origin engine (approved 2026-10-21). Set false to roll back to the previous classification.
USE_QUOTE_ORIGIN_ENGINE=true

REPORT_TIMEZONE=America/New_York
WEEK_STARTS_ON=SUNDAY
